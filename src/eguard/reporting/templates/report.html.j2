<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ report.agent_name }}: {{ report.phase.value }} report</title>
<style>
  :root {
    --bg: #f6f6f3; --panel: #ffffff; --text: #1c1c1a; --muted: #6a6a64; --border: #e2e1da;
    --pass: #1f7a4d; --warn: #a86400; --fail: #b3261e; --undefined: #6b48b3; --na: #86867f;
    --low: #1f7a4d; --moderate: #a86400; --high: #c2410c; --critical: #b3261e;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #151513; --panel: #1f1f1c; --text: #ecebe5; --muted: #a2a198; --border: #33322d;
      --pass: #4cc38a; --warn: #f0a53a; --fail: #ff7a70; --undefined: #b69cf2; --na: #8d8d86;
      --low: #4cc38a; --moderate: #f0a53a; --high: #fb8c4a; --critical: #ff7a70;
    }
  }
  * { box-sizing: border-box; }
  body {
    margin: 0; background: var(--bg); color: var(--text);
    font: 15px/1.55 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }
  main { max-width: 1080px; margin: 0 auto; padding: 32px 20px 48px; }
  h1 { margin: 0 0 4px; font-size: 26px; }
  h2 { margin: 0 0 14px; font-size: 17px; }
  .meta { color: var(--muted); font-size: 13px; }
  .panel {
    background: var(--panel); border: 1px solid var(--border); border-radius: 12px;
    padding: 20px; margin-top: 20px;
  }
  .verdict { display: flex; flex-wrap: wrap; gap: 36px; align-items: flex-start; }
  .big { font-size: 38px; font-weight: 700; line-height: 1.1; }
  .pass-text { color: var(--pass); }
  .fail-text { color: var(--fail); }
  .tier {
    display: inline-block; margin-left: 8px; padding: 3px 12px; border-radius: 999px;
    font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: .03em;
    color: var(--panel); vertical-align: middle;
  }
  .tier.low { background: var(--low); } .tier.moderate { background: var(--moderate); }
  .tier.high { background: var(--high); } .tier.critical { background: var(--critical); }
  .counts { display: flex; flex-wrap: wrap; gap: 8px 16px; margin-top: 6px; }
  .badge {
    display: inline-block; padding: 1px 8px; border: 1px solid currentColor; border-radius: 6px;
    font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .04em;
    white-space: nowrap;
  }
  .badge.pass { color: var(--pass); } .badge.warn { color: var(--warn); }
  .badge.fail { color: var(--fail); } .badge.undefined { color: var(--undefined); }
  .badge.not_applicable { color: var(--na); }
  .table-wrap { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; }
  th, td { text-align: left; padding: 10px 8px; border-bottom: 1px solid var(--border); vertical-align: top; }
  th { font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: .04em; color: var(--muted); }
  tr:last-child td { border-bottom: none; }
  .bar { width: 160px; height: 8px; background: var(--border); border-radius: 4px; overflow: hidden; margin-top: 7px; }
  .bar span { display: block; height: 100%; }
  code { font: 13px ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }
  .message { margin-top: 4px; }
  .remediation { margin-top: 8px; font-size: 14px; }
  .remediation ul { margin: 4px 0 0; padding-left: 20px; }
  details { margin-top: 8px; }
  summary { cursor: pointer; color: var(--muted); font-size: 13px; }
  pre {
    margin: 8px 0 0; padding: 10px 12px; overflow-x: auto; font-size: 12px;
    background: var(--bg); border: 1px solid var(--border); border-radius: 8px;
  }
  .num { font-variant-numeric: tabular-nums; white-space: nowrap; }
  footer { margin-top: 28px; text-align: center; color: var(--muted); font-size: 12px; }
  @media print {
    body { background: #fff; }
    .panel { break-inside: avoid; }
  }
</style>
</head>
<body>
<main>

<header>
  <h1>{{ report.agent_name }} <span class="meta">v{{ report.agent_version }}</span></h1>
  <div class="meta">
    Phase: <strong>{{ report.phase.value }}</strong>
    &middot; Generated {{ report.metadata.created_at.strftime("%Y-%m-%d %H:%M UTC") }}
    &middot; eguard {{ report.metadata.eguard_version }}
    {% if report.metadata.seeds %}&middot; Seeds {{ report.metadata.seeds | join(", ") }}{% endif %}
  </div>
</header>

<section class="panel verdict">
  <div>
    <div class="meta">Composite risk</div>
    {% if composite is none %}
    <div class="big">&ndash;</div>
    <div class="meta">Not evaluated</div>
    {% else %}
    <div class="big">{{ "%.2f" | format(composite) }}<span class="tier {{ tier.value }}">{{ tier.value }}</span></div>
    {% endif %}
  </div>
  <div>
    <div class="meta">Outcome</div>
    {% if report.passed %}
    <div class="big pass-text">Passed</div>
    <div class="meta">No failing or undefined checks</div>
    {% else %}
    <div class="big fail-text">Blocked</div>
    <div class="meta">Failing or undefined checks must be resolved</div>
    {% endif %}
  </div>
  <div>
    <div class="meta">Checks</div>
    <div class="counts">
      {% for status, count in counts.items() %}
      <span><span class="badge {{ status.value }}">{{ status.value | replace("_", " ") }}</span> {{ count }}</span>
      {% endfor %}
    </div>
  </div>
</section>

<section class="panel">
  <h2>Dimensions</h2>
  <div class="table-wrap">
  <table>
    <thead><tr><th>Dimension</th><th>Weight</th><th>Risk</th></tr></thead>
    <tbody>
    {% for dimension, risk in dimension_risks.items() %}
      <tr>
        <td>{{ dimension.value | replace("_", " ") | capitalize }}</td>
        <td class="num">{{ "%.2f" | format(report.config.weights[dimension]) }}</td>
        <td class="num">
          {% if risk is none %}
          <span class="meta">not evaluated in this phase</span>
          {% else %}
          {{ "%.2f" | format(risk) }}
          <div class="bar"><span style="width: {{ (risk * 100) | round(1) }}%; background: var(--{{ tier_of(risk) }});"></span></div>
          {% endif %}
        </td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
</section>

<section class="panel">
  <h2>Checks</h2>
  <div class="table-wrap">
  <table>
    <thead><tr><th>Status</th><th>Check</th><th>Value</th><th>Threshold</th><th>Risk</th></tr></thead>
    <tbody>
    {% for r in report.results %}
      <tr>
        <td><span class="badge {{ r.status.value }}">{{ r.status.value | replace("_", " ") }}</span></td>
        <td>
          <code>{{ r.check_id }}</code>
          <div class="message">{{ r.message }}</div>
          {% if r.remediation %}
          <div class="remediation"><strong>What to do</strong>
            <ul>{% for step in r.remediation %}<li>{{ step }}</li>{% endfor %}</ul>
          </div>
          {% endif %}
          {% if r.evidence %}
          <details><summary>Evidence</summary><pre>{{ r.evidence | pretty }}</pre></details>
          {% endif %}
        </td>
        <td class="num">{{ r.value | number }}</td>
        <td>{{ r.threshold.describe() if r.threshold else "\u2013" }}</td>
        <td class="num">{{ r.risk | number }}</td>
      </tr>
    {% else %}
      <tr><td colspan="5" class="meta">No checks were run.</td></tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
</section>

<section class="panel">
  <h2>Run details</h2>
  <details open><summary>Notes</summary><pre>{{ report.metadata.notes | pretty }}</pre></details>
  <details><summary>Configuration</summary><pre>{{ report.config.model_dump(mode="json") | pretty }}</pre></details>
</section>

<footer>
  Generated by Ethical Guardian Suite (eguard {{ eguard_version }}).
  Scores are computed by deterministic, tested code; definitions are in docs/metric_definitions.md.
</footer>

</main>
</body>
</html>
